<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.project.toko.homeScreen.ui.fragment.HomeScreenFragment"
        android:label="Home">
        <action
            android:id="@+id/action_homeFragment_to_detailScreenFragment"
            app:destination="@id/detailScreenFragment" />
    </fragment>
    <fragment

        android:id="@+id/singleStaffFragment"
        android:name="com.project.toko.personDetailedScreen.ui.fragment.SingleStaffFragment"
        android:label="Staff">
        <argument
            android:name="single_staff_id"
            app:argType="integer" />
        <action
            android:id="@+id/action_singleStaffFragment_to_singleCharacterFragment"
            app:destination="@id/singleCharacterFragment" />
        <action
            android:id="@+id/action_singleStaffFragment_to_detailScreenFragment"
            app:destination="@id/detailScreenFragment" />
    </fragment>
    <fragment
        android:id="@+id/randomAnimeFragment"
        android:name="com.project.toko.randomAnimeScreen.presentation_layer.fragment.RandomAnimeFragment"
        android:label="Random">
        <action
            android:id="@+id/action_randomAnimeFragment_to_detailScreenFragment"
            app:destination="@id/detailScreenFragment"
            app:enterAnim="@anim/slide_in_top"
            app:exitAnim="@anim/slide_out_bottom"
            app:popEnterAnim="@anim/slide_in_bottom"
            app:popExitAnim="@anim/slide_out_top" />

        <!--        <action-->
        <!--            android:id="@+id/action_randomAnimeFragment_to_homeFragment"-->
        <!--            app:destination="@id/homeFragment"-->
        <!--            app:enterAnim="@anim/slide_in_left"-->
        <!--            app:exitAnim="@anim/slide_out_right"-->
        <!--            app:popEnterAnim="@anim/slide_in_right"-->
        <!--            app:popExitAnim="@anim/slide_out_left" />-->
        <!--        <action-->
        <!--            android:id="@+id/action_randomAnimeFragment_to_homeFragment"-->
        <!--            app:destination="@id/homeFragment"-->
        <!--            app:enterAnim="@anim/slide_in_right"-->
        <!--            app:exitAnim="@anim/slide_out_left"-->
        <!--            app:popEnterAnim="@anim/slide_in_left"-->
        <!--            app:popExitAnim="@anim/slide_out_right" />-->
    </fragment>
    <fragment
        android:id="@+id/wholeStaff"
        android:name="com.project.toko.wholeStaffScreen.ui.fragment.WholeStaffFragment"
        android:label="WholeStaff">


        <action
            android:id="@+id/action_wholeStaff_to_singleStaffFragment"
            app:destination="@id/singleStaffFragment" />
    </fragment>
    <fragment
        android:id="@+id/wholeCast"
        android:name="com.project.toko.wholeCastScreen.ui.fragment.WholeCastFragment"
        android:label="WholeCast">

        <action
            android:id="@+id/action_wholeCast_to_singleStaffFragment"
            app:destination="@id/singleStaffFragment" />
        <action
            android:id="@+id/action_wholeCast_to_singleCharacterFragment"
            app:destination="@id/singleCharacterFragment" />
    </fragment>
    <fragment
        android:id="@+id/savedAnimeFragment"
        android:name="com.project.toko.daoScreen.ui.fragment.SavedAnimeFragment"
        android:label="Saved">
        <action
            android:id="@+id/action_savedAnimeFragment_to_detailScreenFragment"
            app:destination="@id/detailScreenFragment" />
        <action
            android:id="@+id/action_savedAnimeFragment_to_singleCharacterFragment"
            app:destination="@id/singleCharacterFragment" />
        <action
            android:id="@+id/action_savedAnimeFragment_to_singleStaffFragment"
            app:destination="@id/singleStaffFragment" />
    </fragment>


    <fragment
        android:id="@+id/singleCharacterFragment"
        android:name="com.project.toko.characterDetailedScreen.ui.fragment.SingleCharacterFragment"
        android:label="Character">
        <argument
            android:name="single_character_id"
            app:argType="integer" />
        <action
            android:id="@+id/action_singleCharacterFragment_to_detailScreenFragment"
            app:destination="@id/detailScreenFragment" />
        <action
            android:id="@+id/action_singleCharacterFragment_to_singleStaffFragment"
            app:destination="@id/singleStaffFragment" />

    </fragment>
    <fragment
        android:id="@+id/detailScreenFragment"
        android:name="com.project.toko.detailScreen.ui.fragment.DetailScreenFragment"
        android:label="Detail">
        <argument
            android:name="detail_screen_id"
            app:argType="integer" />
        <action
            android:id="@+id/action_detailScreenFragment_self"
            app:destination="@id/detailScreenFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />
        <action
            android:id="@+id/action_detailScreenFragment_to_singleCharacterFragment"
            app:destination="@id/singleCharacterFragment" />
        <action
            android:id="@+id/action_detailScreenFragment_to_singleStaffFragment"
            app:destination="@id/singleStaffFragment" />
        <action
            android:id="@+id/action_detailScreenFragment_to_wholeCast"
            app:destination="@id/wholeCast" />
        <action
            android:id="@+id/action_detailScreenFragment_to_wholeStaff"
            app:destination="@id/wholeStaff" />
    </fragment>

</navigation>


